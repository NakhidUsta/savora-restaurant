# Serveri işə salmadan əvvəl bu faylı .env adı ilə kopyalayın və doldurun.

PORT=5000

# SQL Server bağlantısı (SQL Authentication — Mixed Mode aktiv olmalıdır)
DB_SERVER=localhost
DB_NAME=savora
DB_USER=savora_app
DB_PASSWORD=

# CORS üçün icazə verilən frontend ünvanı
CLIENT_ORIGIN=http://localhost:5173

# Admin JWT girişi üçün (məxfi, təsadüfi uzun bir sətir seçin)
JWT_SECRET=dəyişin_bunu_təsadüfi_uzun_bir_sirlə
